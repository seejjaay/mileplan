{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mileplan.app/schemas/doc.schema.json",
  "title": "MilePlan doc.json",
  "description": "Per-client details for the document templates that plan.json does not carry. Read by `npm run doc`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["client", "payment_method", "package", "fees", "source_code", "dispute_city"],
  "properties": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "representative": { "type": "string", "minLength": 1 },
        "representative_title": { "type": "string", "minLength": 1 }
      }
    },
    "academic": { "type": "boolean", "default": false },
    "school": { "type": "string", "minLength": 1 },
    "course": { "type": "string", "minLength": 1 },
    "payment_method": { "type": "string", "minLength": 1 },
    "payment_plan": { "enum": ["50-50", "milestones"], "default": "50-50" },
    "package": { "type": "string", "minLength": 1 },
    "fees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "amount"],
            "properties": { "label": { "type": "string", "minLength": 1 }, "amount": { "type": "number", "exclusiveMinimum": 0 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["addon", "qty"],
            "properties": { "addon": { "type": "string", "minLength": 1 }, "qty": { "type": "integer", "minimum": 1 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["rush"],
            "properties": { "rush": { "const": true } }
          }
        ]
      }
    },
    "source_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multiplier"],
      "properties": { "multiplier": { "type": "number", "minimum": 1.5, "maximum": 3 } }
    },
    "dispute_city": { "type": "string", "minLength": 1 },
    "agreement_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "revision_rounds": { "type": "integer", "minimum": 2, "default": 2, "description": "Revision rounds for the whole project, across all milestones. 2 is the minimum every project gets." },
    "warranty_days": { "type": "integer", "minimum": 0, "default": 30 },
    "acceptance_days": { "type": "integer", "minimum": 1, "default": 7 }
  }
}
